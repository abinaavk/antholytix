# Copy this file to .env and fill in real values (never commit .env itself).

# Random long string used to sign JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Defaults to a local SQLite file. For production use Postgres/MySQL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/antholytix
DATABASE_URL=sqlite:///antholytix.db

# Gmail (or any SMTP) account used to send OTP verification emails.
# For Gmail you need an "app password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# Web client ID from Google Cloud Console, used to verify Google Sign-In tokens
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Comma-separated list of frontend origins allowed to call this API.
# Use * only for local testing — lock this down before going live.
CORS_ORIGINS=*
